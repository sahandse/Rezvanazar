# این فایل را به .env.local کپی کنید و مقادیر واقعی را وارد کنید.
# .env.local هرگز نباید commit شود (در .gitignore قرار دارد).
#
# توجه: چون این پروژه یک سایت استاتیک (GitHub Pages) است، این مقادیر در
# نهایت داخل باندل جاوااسکریپت عمومی سایت هم قرار می‌گیرند و برای هر
# بازدیدکننده‌ای با «View Source» قابل مشاهده‌اند. برای پنهان‌ماندن واقعی
# توکن، باید یک پراکسی سمت سرور (مثلاً یک Cloudflare Worker یا تابع
# serverless) بین سایت و API تلگرام/بله قرار بگیرد.

VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_CHAT_ID=
VITE_BALE_BOT_TOKEN=
VITE_BALE_CHAT_ID=
